# Production values. Both are public: they end up in the built JavaScript. Never put a secret here.
# Worker URL printed by `wrangler deploy`, no trailing slash.
VITE_CONCIERGE_API_URL=https://thg-concierge.lqteam.workers.dev
# Public Turnstile sitekey from the Cloudflare dashboard. The widget must be the Invisible type.
# Empty means Turnstile is off in the page; set the Worker's TURNSTILE_SECRET_KEY only after this is filled and deployed.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAF1EOwAyq1zjnBko

# Analytics. All three are public: they end up in the built JavaScript.
# GA4 Measurement ID. The placeholder G-XXXXXXX means analytics is off; the real ID replaces it at launch.
VITE_GA4_ID=G-XXXXXXX
# "true" sends debug_mode and lets analytics load outside production builds. Leave empty here.
VITE_GA4_DEBUG=
# Cloudflare Web Analytics beacon token (Analytics & Logs -> Web Analytics). Empty means the beacon is off.
VITE_CF_BEACON_TOKEN=
