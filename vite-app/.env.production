# Filled in after the Worker is deployed (see docs/plans/2026-11-03-ai-concierge.md section 5).
# Both values are public: they end up in the built JavaScript. Never put a secret here.
#
# While VITE_CONCIERGE_API_URL is empty the chat helper does not appear at all in a
# production build (no bubble, and the section's "Try it now" button is left out).
#
# Worker URL printed by `wrangler deploy`, no trailing slash.
VITE_CONCIERGE_API_URL=
# Public Turnstile sitekey from the Cloudflare dashboard (leave empty to skip Turnstile).
# The widget MUST be created as the Invisible type: the widget runs in an off-screen 0x0
# container, so a Managed (or Non-interactive) widget could never show a challenge and
# every token request would time out.
VITE_TURNSTILE_SITE_KEY=
