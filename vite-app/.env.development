# Local development only. Nothing here is a secret.
# The Worker runs on 8787 with `npm run dev` in concierge-worker/.
VITE_CONCIERGE_API_URL=http://localhost:8787
# Cloudflare's published Turnstile test sitekey: invisible widget, always passes.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000BB

# Analytics is off in development. To try it locally:
#   VITE_GA4_ID=G-TEST VITE_GA4_DEBUG=true npm run dev
# (shell variables win over this file). Events then log to the console as "[analytics]".
VITE_GA4_ID=G-XXXXXXX
VITE_GA4_DEBUG=
VITE_CF_BEACON_TOKEN=
