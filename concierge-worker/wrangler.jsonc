{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thg-concierge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  // Keep application logs (the counters the Worker writes with console.log). Turn off
  // invocation logs: Cloudflare would otherwise record a line per request that includes the
  // client IP, which the privacy statement says this service does not keep.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },

  // Public, non-secret settings. Secrets (LLM_API_KEY, RESEND_API_KEY,
  // TURNSTILE_SECRET_KEY, LEADQUIK_WEBHOOK_URL) are set with
  // `npx wrangler secret put <NAME>` and never live in this file.
  "vars": {
    "ALLOWED_ORIGINS": "https://thgservices.io,https://www.thgservices.io,http://localhost:3000,http://localhost:4173",
    "MODEL": "claude-haiku-5-5",
    "DAILY_LLM_CAP": "2000",
    "LEAD_TO_EMAIL": "developer@leadquik.com",
    "LEAD_FROM_EMAIL": "THG AI Services <concierge@leadquik.com>",
    // Used only to hash client IPs into Durable Object names. Not a secret.
    "RATE_SALT": "92fc073eb83ffe453544cd5c7fdcfa7c",
    // `.dev.vars` and the test config override this with "mock".
    "LLM_PROVIDER": "anthropic",

    // Push-to-talk voice (see README "Voice"). Speech-to-text is on whenever the AI binding below
    // exists; replies are read aloud by the browser unless VOICE_TTS is "aura", which switches on
    // POST /tts (Deepgram Aura-1, at most $1.50 a day at the 100000-character cap below, about 300
    // replies; needs the Workers Paid plan).
    "VOICE_TTS": "browser",
    "VOICE_SPEAKER": "asteria",
    // Audio seconds of speech-to-text per Eastern-time day across all visitors (9000 = 150 minutes,
    // inside the Workers Free plan's 10,000 neurons a day), and per chat session (3 minutes).
    "VOICE_DAILY_STT_SECONDS": "9000",
    "VOICE_SESSION_SECONDS": "180",
    // Characters of premium text-to-speech per Eastern-time day. Used only when VOICE_TTS is "aura".
    "VOICE_DAILY_TTS_CHARS": "100000"
  },

  // Workers AI: Whisper for POST /stt and, only when VOICE_TTS is "aura", Aura-1 for POST /tts.
  // Billed to the account (Free plan: 10,000 neurons a day). It always runs on Cloudflare's network,
  // so `wrangler dev` needs a logged-in account for it.
  "ai": { "binding": "AI", "remote": true },

  "durable_objects": {
    "bindings": [{ "name": "LIMITER", "class_name": "Limiter" }]
  },
  // SQLite-backed classes are what the Workers free plan allows.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Limiter"] }],

  // Import knowledge.md and system-prompt.md as plain text strings.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }]
}
