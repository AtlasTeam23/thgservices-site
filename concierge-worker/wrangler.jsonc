{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thg-concierge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  // Keep application logs (the counters the Worker writes with console.log). Turn off
  // invocation logs: Cloudflare would otherwise record a line per request that includes the
  // client IP, which the privacy statement says this service does not keep.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },

  // Public, non-secret settings. Secrets (LLM_API_KEY, RESEND_API_KEY,
  // TURNSTILE_SECRET_KEY, LEADQUIK_WEBHOOK_URL, ELEVENLABS_API_KEY, SITE_CHECKER_URL,
  // SITE_CHECKER_SECRET, CHECKER_LEADQUIK_URL) are set with
  // `npx wrangler secret put <NAME>` and never live in this file.
  "vars": {
    "ALLOWED_ORIGINS": "https://thgservices.io,https://www.thgservices.io,http://localhost:3000,http://localhost:4173",
    "MODEL": "claude-haiku-5-5",
    "DAILY_LLM_CAP": "2000",
    "LEAD_TO_EMAIL": "developer@leadquik.com",
    "LEAD_FROM_EMAIL": "THG AI Services <concierge@leadquik.com>",
    // Used only to hash client IPs into Durable Object names. Not a secret.
    "RATE_SALT": "754befd861b9c1e6eccc60be5fe04f7d",
    // `.dev.vars` and the test config override this with "mock".
    "LLM_PROVIDER": "anthropic",

    // Spoken replies (see README "Voice"). There is no voice input on the site: speech-to-text is off
    // (VOICE_DAILY_STT_SECONDS is 0 below). Replies are spoken only when VOICE_TTS is "aura" or "elevenlabs", which switch on POST /tts
    // (a paid voice; Aura also needs the Workers Paid plan); "browser" means no spoken replies at all.
    "VOICE_TTS": "elevenlabs",
    // Which Aura model speaks when VOICE_TTS is "aura": "aura-1" ($0.015 per 1,000 characters) or "aura-2"
    // (more natural, $0.030). VOICE_SPEAKER must be one of that model's speakers or the model's default is
    // used and the Worker logs tts_speaker_fallback. "asteria" exists on both.
    "VOICE_TTS_MODEL": "aura-1",
    "VOICE_SPEAKER": "asteria",
    // ElevenLabs, when VOICE_TTS is "elevenlabs" (the key is the secret ELEVENLABS_API_KEY). The voice id comes
    // from `npm run eleven:voices`; while it is empty the route answers 503. This one is the premade voice
    // "Matilda - Knowledgable, Professional", chosen by listening on 2026-11-04.
    "VOICE_ELEVEN_VOICE_ID": "XrExE9yKIg1WjnnlVkGX",
    "VOICE_ELEVEN_MODEL": "eleven_flash_v2_5",
    "VOICE_ELEVEN_FORMAT": "mp3_22050_32",
    // Spoken replies per visitor (one address) per Eastern-time day on either paid voice, and the extra replies
    // that address earns the same day by leaving a name, a valid email and a phone number in the lead form.
    "VOICE_TTS_PER_IP_PER_DAY": "5",
    "VOICE_TTS_BONUS": "5",
    // Audio seconds of speech-to-text per Eastern-time day across all visitors. 0 turns voice input off
    // (POST /stt answers 503 and /health reports stt: false). To turn it back on, set 9000 (150 minutes,
    // inside the Workers Free plan's 10,000 neurons a day); the widget has no microphone button now.
    // Below: the per-session allowance (3 minutes), used only when voice input is on.
    "VOICE_DAILY_STT_SECONDS": "0",
    "VOICE_SESSION_SECONDS": "180",
    // Characters of paid text-to-speech per Eastern-time day, all visitors together (VOICE_TTS "aura" or
    // "elevenlabs"). 50000 is at most about $2 a day on ElevenLabs Flash ($0.04 per 1,000 characters), roughly
    // 150 spoken replies; Aura-1 would be $0.75 and Aura-2 $1.50 for the same characters.
    "VOICE_DAILY_TTS_CHARS": "50000",

    // Free website checker (/checker/*). Its secrets are SITE_CHECKER_URL, SITE_CHECKER_SECRET and
    // CHECKER_LEADQUIK_URL (see README "Website checker"). The Turnstile site key is published on the site and
    // verification is on: without TURNSTILE_SECRET_KEY (unless the Worker is reached on localhost) the routes
    // answer 503 checker_not_ready. Without the var the code also treats it as "true".
    "CHECKER_REQUIRE_TURNSTILE": "true",
    // Scans per Eastern-time day across all visitors.
    "CHECKER_DAILY_SCANS": "1000",
    // Action plans (one model call each) per Eastern-time day, all visitors. A plan is written only when this
    // and DAILY_LLM_CAP both have room.
    "CHECKER_DAILY_PLANS": "300"
  },

  // Workers AI: Whisper for POST /stt (off while VOICE_DAILY_STT_SECONDS is 0) and, only when VOICE_TTS is "aura", Aura-1 for POST /tts.
  // Billed to the account (Free plan: 10,000 neurons a day). It always runs on Cloudflare's network,
  // so `wrangler dev` needs a logged-in account for it.
  "ai": { "binding": "AI", "remote": true },

  "durable_objects": {
    "bindings": [{ "name": "LIMITER", "class_name": "Limiter" }]
  },
  // SQLite-backed classes are what the Workers free plan allows.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Limiter"] }],

  // Import knowledge.md and system-prompt.md as plain text strings.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }]
}
