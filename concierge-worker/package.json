{
  "name": "thg-concierge-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker backend for the thgservices.io AI Website Concierge",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "dev:mock": "wrangler dev --port 8787 --var LLM_PROVIDER:mock",
    "test": "vitest run",
    "test:probe": "node --test \"scripts/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "probe": "node scripts/probe.mjs",
    "eleven:voices": "node scripts/eleven-voices.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261103.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.157.0"
  }
}
